{
  "name": "openchamber-sp-log",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun scripts/build.ts",
    "check": "bun run typecheck && bun run build && bun test"
  },
  "devDependencies": {
    "@openchamber/sdk": "2.7.2",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": { "openchamber": ">=2.7.1" },
    "id": "sp-log",
    "name": "SP Log",
    "icon": "time-line",
    "contributes": {
      "panel": { "entry": "dist/panel/index.html", "mobile": true },
      "statusSection": { "entry": "dist/status/index.html", "title": "SP Log", "height": 120 },
      "attach": "dialog",
      "capabilities": ["model"],
      "service": { "entry": "dist/service/main.js", "runtime": "host", "keepRunning": true },
      "marks": true,
      "blocks": [
        {
          "name": "SpLogDraft",
          "description": "SP-Log-Entwurf als Karte: logId, Titel, Zusammenfassung, Stunden (Zahl als Text). Nur auf [SP-Log-Anfrage] antworten.",
          "args": ["logId", "title", "summary", "hours"],
          "entry": "dist/block/index.html",
          "height": 160
        }
      ],
      "sessionEvents": { "events": ["turn-finished", "turn-failed"] },
      "sessionControl": { "content": true },
      "actions": [
        { "id": "log-session", "label": "Nach Super Productivity loggen", "where": "session", "payload": ["messages"], "mode": "open" }
      ],
      "integration": {
        "name": "Super Productivity",
        "description": "Log-Gateway auf dem Dell",
        "token": {
          "apiOrigin": "https://dev-sp.nomobo.de",
          "account": { "path": "/me", "name": "name" },
          "scheme": "bearer"
        }
      }
    }
  }
}
